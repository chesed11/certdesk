[Unit]
Description=Certdesk controlled certificate renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -I /opt/certdesk/privileged_worker.py
TimeoutStartSec=infinity
